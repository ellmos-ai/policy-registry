{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ellmos.dev/delegation-issuer-trust.v1.schema.json",
  "title": "ellmos delegation issuer trust store v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "issuers"],
  "properties": {
    "schema": {"const": "ellmos.delegation-issuer-trust.v1"},
    "issuers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issuer_id", "key_id", "algorithm", "public_key", "key_pin"],
        "properties": {
          "issuer_id": {"$ref": "#/$defs/code"},
          "key_id": {"$ref": "#/$defs/code"},
          "algorithm": {"const": "ed25519"},
          "public_key": {"type": "string", "minLength": 44, "maxLength": 44},
          "key_pin": {"$ref": "#/$defs/hash"}
        }
      }
    }
  },
  "$defs": {
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:/-]{1,127}$"
    },
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
