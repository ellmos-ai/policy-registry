{
  "schema": "ellmos.module.v2",
  "id": "policy-registry",
  "display_name": "policy-registry",
  "category": "control",
  "kind": "library",
  "status": "active",
  "visibility": "public",
  "provides": [
    "policy.registry",
    "policy.resolve",
    "policy.discovery",
    "delegation.candidate.resolve"
  ],
  "requires": [],
  "optional": [
    "sync.yard",
    "tom.advisory",
    "mcp"
  ],
  "conflicts": [],
  "surfaces": [
    "library",
    "cli",
    "mcp-adapter"
  ],
  "state": {
    "ownership": "module",
    "location": "user-home"
  },
  "boundaries": {
    "network": "none",
    "data": "user-local",
    "platforms": [
      "windows",
      "macos",
      "linux"
    ]
  },
  "source_of_truth": {
    "type": "git-repository",
    "path": ".",
    "repository": "https://github.com/ellmos-ai/policy-registry"
  },
  "adapters": [
    {
      "id": "sync-policies-v1",
      "target": ".SYNC/_policies",
      "status": "optional",
      "note": "Imports existing metadata pointers and exports a non-authoritative aggregated view."
    },
    {
      "id": "system-gap-optional",
      "target": "system-gap-master",
      "status": "optional",
      "note": "Transport seam only; the local registry remains authoritative."
    },
    {
      "type": "mcp",
      "id": "policy-registry"
    }
  ]
}
