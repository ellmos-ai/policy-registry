{
  "schema": "ellmos.module.v2",
  "id": "policy-registry",
  "version": "0.1.5",
  "display_name": "policy-registry",
  "category": "control",
  "kind": "library",
  "status": "active",
  "visibility": "public",
  "provides": [
    "policy.registry",
    "policy.resolve",
    "policy.discovery",
    "delegation.candidate.resolve",
    "decision.location.pointers",
    "rule.append-only",
    "rule.audit-fields",
    "authority.mode-switch",
    "byum.decision-candidate.pointer"
  ],
  "requires": [],
  "optional": [
    "sync.yard",
    "tom.advisory",
    "mcp",
    "decision.clicker",
    "byum.decision-prediction"
  ],
  "conflicts": [],
  "surfaces": [
    "library",
    "cli",
    "mcp-adapter"
  ],
  "state": {
    "ownership": "module",
    "location": "user-home"
  },
  "boundaries": {
    "network": "none",
    "data": "user-local",
    "platforms": [
      "windows",
      "macos",
      "linux"
    ]
  },
  "source_of_truth": {
    "type": "git-repository",
    "path": ".",
    "repository": "https://github.com/ellmos-ai/policy-registry"
  },
  "adapters": [
    {
      "type": "seam",
      "id": "sync-policies-v1",
      "target": ".SYNC/_policies",
      "status": "optional",
      "note": "Imports existing metadata pointers and exports a non-authoritative aggregated view."
    },
    {
      "type": "seam",
      "id": "system-gap-optional",
      "target": "system-gap-master",
      "status": "optional",
      "note": "Transport seam only; the local registry remains authoritative."
    },
    {
      "type": "seam",
      "id": "decision-clicker-v1",
      "target": "decision-clicker",
      "status": "optional",
      "note": "Structural sub-module relationship (T-20260824-474639761): decision-clicker writes into the same _DECISIONS chain that this registry's adapters.decisions module indexes as pointers. Bound as an importable optional seam (adapters.decision_clicker.available()), not a fixed manifest bundle, so decision-clicker stays independently and manually startable."
    },
    {
      "type": "seam",
      "id": "byum-pointer-v1",
      "target": "build-your-users-mind",
      "status": "optional",
      "note": "Consumes only a prevalidated BYUM v2 pointer envelope and projects non-authoritative decision-candidate metadata. No BYUM import, event parsing, raw content, adoption, execution, or receipt authority."
    },
    {
      "type": "mcp",
      "id": "policy-registry"
    }
  ]
}
