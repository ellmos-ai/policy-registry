{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ellmos.dev/schemas/ellmos.module.v2.schema.json",
  "title": "ellmos module manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "category",
    "kind",
    "status",
    "visibility",
    "provides",
    "requires",
    "optional",
    "conflicts",
    "surfaces",
    "state",
    "boundaries",
    "source_of_truth"
  ],
  "properties": {
    "schema": {
      "const": "ellmos.module.v2"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "released",
        "development",
        "alpha",
        "experimental",
        "staging",
        "planned",
        "deprecated"
      ]
    },
    "visibility": {
      "enum": [
        "public",
        "public-candidate",
        "internal",
        "private"
      ]
    },
    "description": {
      "type": "string"
    },
    "package": {
      "type": [
        "string",
        "null"
      ]
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "provides": {
      "$ref": "#/$defs/capabilities"
    },
    "requires": {
      "$ref": "#/$defs/capabilities"
    },
    "optional": {
      "$ref": "#/$defs/capabilities"
    },
    "conflicts": {
      "$ref": "#/$defs/capabilities"
    },
    "surfaces": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "library",
          "cli",
          "service",
          "ui",
          "workflow",
          "skill",
          "dataset",
          "template",
          "mcp-adapter"
        ]
      }
    },
    "profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]*$"
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownership",
        "location"
      ],
      "properties": {
        "ownership": {
          "enum": [
            "module",
            "external",
            "none"
          ]
        },
        "location": {
          "enum": [
            "user-home",
            "project",
            "external",
            "none"
          ]
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "data",
        "platforms"
      ],
      "properties": {
        "network": {
          "enum": [
            "none",
            "local",
            "listed",
            "optional",
            "transport-defined"
          ]
        },
        "data": {
          "enum": [
            "none",
            "public",
            "user-local",
            "sensitive",
            "application-defined"
          ]
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "windows",
              "macos",
              "linux",
              "web"
            ]
          }
        }
      }
    },
    "source_of_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path"
      ],
      "properties": {
        "type": {
          "enum": [
            "local-directory",
            "git-repository",
            "package"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "id"
        ],
        "properties": {
          "type": {
            "enum": [
              "mcp",
              "plugin",
              "skill",
              "cli-wrapper",
              "connector",
              "repository-writer",
              "provider-hook",
              "seam"
            ],
            "description": "Art des Adapters. mcp/plugin/skill/cli-wrapper/connector/repository-writer/provider-hook sind Integrationspunkte (das Modul spricht etwas an oder wird angesprochen). seam ist eine Vertragsnaht zu einem anderen Modul -- der Begriff stammt aus den bestehenden Notizen der Module selbst, er ist nicht neu erfunden."
          },
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "target": {
            "type": "string",
            "description": "Gegenstueck der Naht: Modul-ID, Capability oder Pfad."
          },
          "status": {
            "type": "string",
            "description": "Zustand der Naht, z.B. contract, optional, verified."
          },
          "note": {
            "type": "string",
            "description": "Freitext zur Naht. Bewusst unstrukturiert -- deshalb darf kein maschineller Konsument sich darauf stuetzen."
          },
          "role": {
            "type": "string",
            "description": "Rolle des Moduls in dieser Beziehung."
          },
          "networks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "description": "Transportwege, ueber die die Naht bedient wird."
          },
          "optional_dependency": {
            "type": "string",
            "description": "Paket, das die Naht nutzt, wenn es vorhanden ist."
          },
          "required_for": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "description": "Faehigkeiten, die ohne diese Naht nicht verfuegbar sind."
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "origin_path",
        "license",
        "extraction_date"
      ],
      "description": "Herkunft eines Moduls, das aus einem groesseren System herausgeloest wurde. Bewusst geschlossen und mit Pflichtfeldern: Ein Herkunftsnachweis, dem Angaben fehlen duerfen, belegt nichts. Kein Ersatz fuer Freitextnotizen.",
      "properties": {
        "source": {
          "type": "string",
          "description": "Name des Ursprungssystems oder der Ursprungskomponente."
        },
        "origin_path": {
          "type": "string",
          "description": "Pfad im Ursprungssystem, aus dem extrahiert wurde."
        },
        "license": {
          "type": "string",
          "description": "Lizenz, unter der die Extraktion erfolgte."
        },
        "extraction_date": {
          "type": "string",
          "format": "date",
          "description": "Datum der Herausloesung (ISO 8601)."
        }
      }
    }
  },
  "$defs": {
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    }
  }
}
